{
  "name": "xfinalw3",
  "version": "0.0.1",
  "description": "A modern Web3 development framework for building dApps on Ethereum",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "account": "pnpm foundry:account",
    "account:generate": "pnpm foundry:generate",
    "account:import": "pnpm foundry:account-import",
    "account:reveal-pk": "pnpm --filter @w3s/foundry account:reveal-pk",
    "chain": "pnpm foundry:chain",
    "compile": "pnpm foundry:compile",
    "deploy": "pnpm foundry:deploy",
    "deploy:local": "pnpm --filter @w3s/foundry deploy:local",
    "flatten": "pnpm foundry:flatten",
    "fork": "pnpm foundry:fork",
    "format": "pnpm next:format && pnpm foundry:format",
    "foundry:account": "pnpm --filter @w3s/foundry account",
    "foundry:account-import": "pnpm --filter @w3s/foundry account:import",
    "foundry:chain": "pnpm --filter @w3s/foundry chain",
    "foundry:clean": "pnpm --filter @w3s/foundry clean",
    "foundry:compile": "pnpm --filter @w3s/foundry compile",
    "foundry:deploy": "pnpm --filter @w3s/foundry deploy",
    "foundry:deploy-verify": "pnpm --filter @w3s/foundry deploy:verify",
    "foundry:flatten": "pnpm --filter @w3s/foundry flatten",
    "foundry:fork": "pnpm --filter @w3s/foundry fork",
    "foundry:format": "pnpm --filter @w3s/foundry format",
    "foundry:generate": "pnpm --filter @w3s/foundry account:generate",
    "foundry:lint": "pnpm --filter @w3s/foundry lint",
    "foundry:test": "pnpm --filter @w3s/foundry test",
    "foundry:verify": "pnpm --filter @w3s/foundry verify",
    "generate": "pnpm foundry:generate",
    "postinstall": "husky install",
    "indexer": "pnpm --filter @w3s/indexer dev",
    "indexer:build": "pnpm --filter @w3s/indexer build",
    "indexer:codegen": "pnpm --filter @w3s/indexer codegen",
    "indexer:db": "pnpm --filter @w3s/indexer db",
    "indexer:serve": "pnpm --filter @w3s/indexer serve",
    "cron": "pnpm --filter @w3s/cron dev",
    "start": "pnpm --filter @w3s/sveltekit dev",
    "ipfs": "pnpm --filter @w3s/nextjs ipfs",
    "lint": "pnpm next:lint && pnpm foundry:lint",
    "next:build": "pnpm --filter @w3s/nextjs build",
    "next:check-types": "pnpm --filter @w3s/nextjs check-types",
    "next:format": "pnpm --filter @w3s/nextjs format",
    "next:lint": "pnpm --filter @w3s/nextjs lint",
    "next:serve": "pnpm --filter @w3s/nextjs serve",
    "precommit": "lint-staged",
    "test": "pnpm foundry:test",
    "vercel": "pnpm --filter @w3s/nextjs vercel",
    "vercel:login": "pnpm --filter @w3s/nextjs vercel:login",
    "vercel:yolo": "pnpm --filter @w3s/nextjs vercel:yolo",
    "verify": "pnpm foundry:verify",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint .",
    "biome:ci": "biome ci ."
  },
  "devDependencies": {
    "biome": "^0.3.3",
    "husky": "~9.1.6",
    "lint-staged": "~13.2.2"
  },
  "engines": {
    "node": ">=20.18.3"
  }
}
