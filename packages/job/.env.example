# Prefer file-based key (chmod 600). Plaintext PRIVATE_KEY refused in production
# unless ALLOW_PLAINTEXT_PRIVATE_KEY=1.
# PRIVATE_KEY_FILE=/run/secrets/cron_pk
PRIVATE_KEY=
# ALLOW_PLAINTEXT_PRIVATE_KEY=1
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
# Chain writes default off; set true to allow execute()/writeContractData
CRON_WRITE_ENABLED=false
# Health endpoint: GET /health → { ok, writesEnabled }
CRON_HEALTH_PORT=3001
# Graceful shutdown: await in-flight jobs up to this many ms
CRON_DRAIN_TIMEOUT_MS=30000
# Indexer (bponder) for GraphQL / internal keepers
INDEXER_URL=http://127.0.0.1:42069
KEEPER_SECRET=
# Logs: json in production by default; force with LOG_FORMAT=json|text
# LOG_FORMAT=text
