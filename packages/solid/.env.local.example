# ============================================================
# 星能海马 Star Staking — Local anvil environment
# 用法：cp solid/.env.local.example solid/.env.local
#
# 「在用的变量」= solid/src 里 import.meta.env 实际读取的全部键（共 18 个，核对：
# grep -rn "import\.meta\.env" solid/src，含 import.meta.env['KEY'] 动态取键的写法）。
# 本文件是其本地 anvil 变体，键清单与 .env.example 一致。
# ============================================================

# Local RPC (anvil default)
VITE_RPC_56=http://127.0.0.1:8545
# 本地不需要公共备节点；留空 = 只用上面这一条
VITE_RPC_56_FALLBACKS=

# Mock USDT（LocalDeploy.s.sol 部署后填入）
VITE_USDT_ADDRESS=0x...

# ── MMM 协议（MmmDeploy.s.sol / LocalDeploy.s.sol）──
VITE_MMM_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_ORDER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_MATCHING_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_REWARD_ADDRESS=0x0000000000000000000000000000000000000000

# 平台自营单入口：逗号分隔的平台地址；本地不配 → 前端不显示平台单入口
VITE_PLATFORM_ACCOUNTS=

# ── ANX + 节点（AnxNodeDeploy.s.sol）──
VITE_ANX_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ANX_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
VITE_NODE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# ANX/USDT 池（m/anx 读池价；留空或 0 地址 → 池价显示「未知」）
VITE_ANX_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# 系统顶号（无推荐人时默认挂的地址）。留空 = 代码内置
# 0xEC2C15e6382569e9e125f2ED2134e09c71C9F44D（node.ts:44）
VITE_ROOT_REFERRER=

# 官网外链。留空 = https://anx.autos（routes/m/node.tsx:44）
VITE_ANX_WEBSITE=https://anx.autos

# Ponder GraphQL（dev server 代理 /ponder/graphql → :42069）
VITE_PONDER_GRAPHQL_URL=/ponder/graphql
# 可选：内部 REST 基址覆盖。留空 = 从上面的 GraphQL URL 推导 origin（通常不要填）
VITE_MMM_API_BASE=

# WalletConnect（本地一般不配；留空 → WC 连接器不注册，扫码连接不可用）
VITE_WALLETCONNECT_PROJECT_ID=

# dev server 代理（app.config.ts 走 process.env，不进浏览器包）
VITE_API_PROXY=http://localhost:42070/api
# VITE_PONDER_PROXY=http://127.0.0.1:42069    ← 默认值即此，通常不用填

# ============================================================
# ⚠️ 已废弃 / 无代码引用 —— 请勿在新环境里配置
#
# 逐条 grep 核实（grep -rn "import\.meta\.env" solid/src，含 import.meta.env['KEY']
# 动态取键）：下面 5 个键在 solid/src 里 0 处被读取，填了也不会影响任何页面。保留在此
# 仅为对照历史 .env / 一期文档，不代表支持；确认无误后可整块删除。
#   · VITE_FUNDPOOL_ADDRESS / VITE_STAR_ADDRESS / VITE_PANCAKE_ROUTER_ADDRESS /
#     VITE_WBNB_ADDRESS / VITE_PRICE_ORACLE_ADDRESS —— 一期 FundPool/STAR 遗留，
#     二期 MMM 走 OrderManager 内的 DEX 路径，前端不再读这些地址。
# ============================================================
# VITE_FUNDPOOL_ADDRESS=0x...
# VITE_STAR_ADDRESS=0x...
# VITE_PANCAKE_ROUTER_ADDRESS=0x...
# VITE_WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
# VITE_PRICE_ORACLE_ADDRESS=0x...
