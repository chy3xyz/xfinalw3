# ============================================================
# Solid 前端 — BSC 主网生产环境（已填入部署地址）
# 用法：复制为 solid/.env 或 solid/.env.production
# 构建：cd packages/solid && bun run build
#
# 「在用的变量」= solid/src 里 import.meta.env 实际读取的全部键（共 18 个，核对：
# grep -rn "import\.meta\.env" solid/src，含 import.meta.env['KEY'] 动态取键的写法）。
# 键清单与 .env.example 一致；ANX/节点地址与线上 solid/.env.production 同步。
# ============================================================

VITE_RPC_56=https://bsc-rpc.publicnode.com
VITE_RPC_56_FALLBACKS=https://bsc-dataseed.binance.org/,https://rpc.ankr.com/bsc

VITE_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Ponder GraphQL — /_admin 统计面板（生产需公网可达 + HTTPS，必须是绝对 URL）
VITE_PONDER_GRAPHQL_URL=https://api.anx.autos/graphql
# 可选：内部 REST 基址覆盖。留空 = 从上面的 GraphQL URL 推导 origin（通常不要填）
VITE_MMM_API_BASE=https://api.anx.autos

# WalletConnect（移动端扫码连接；https://cloud.walletconnect.com 申请 Project ID）
# 留空 → walletConnectEnabled()=false，WC 连接器不注册，移动端扫码连接不可用
VITE_WALLETCONNECT_PROJECT_ID=

# ── MMM 协议（MmmDeploy.s.sol 部署后填入；全 0 = MMM 未上线）──
VITE_MMM_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_ORDER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_MATCHING_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_REWARD_ADDRESS=0x0000000000000000000000000000000000000000

# 平台自营单入口：4 个平台地址，逗号分隔；不配则前端不显示平台单入口。
# 必须是同一份名单：链上 OrderManager.isPlatform == keeper 的 PLATFORM_ACCOUNTS == 这里的值。
VITE_PLATFORM_ACCOUNTS=

# ── ANX + 节点（BSC 主网 2026-08-30 部署）──
VITE_ANX_ADDRESS=0xC645C1a988b076ABdAfB1583486b1b6AE0Ec95a7
VITE_ANX_VESTING_ADDRESS=0xFee48bA66a0Df93eD953f8d301f59a7303DE2Fb1
VITE_NODE_REGISTRY_ADDRESS=0xfd6464AACCfDce0b91Ad48564Fe79e1E86eaaEAC

# ANX/USDT 池（m/anx 读池价；留空或 0 地址 → 池价显示「未知」）
VITE_ANX_POOL_ADDRESS=0x2ce4EB9186Ea20bc283FF5AcBfE2Bc7a3B575fde

# 系统顶号（无推荐人时默认挂的地址）。留空 = 代码内置
# 0xEC2C15e6382569e9e125f2ED2134e09c71C9F44D，须与链上 rootReferrer 一致
VITE_ROOT_REFERRER=0xEC2C15e6382569e9e125f2ED2134e09c71C9F44D

# 官网外链。留空 = https://anx.autos（routes/m/node.tsx:44）
VITE_ANX_WEBSITE=https://anx.autos

# ============================================================
# ⚠️ 已废弃 / 无代码引用 —— 请勿在新环境里配置
#
# 逐条 grep 核实（grep -rn "import\.meta\.env" solid/src，含 import.meta.env['KEY']
# 动态取键）：下面这些键在 solid/src 里 0 处被读取，填了也不会影响任何页面。保留在此
# 仅为对照历史 .env / 一期文档，不代表支持；确认无误后可整块删除。
#   · VITE_FUNDPOOL_ADDRESS / VITE_STAR_ADDRESS / VITE_PANCAKE_ROUTER_ADDRESS /
#     VITE_WBNB_ADDRESS / VITE_PRICE_ORACLE_ADDRESS —— 一期 FundPool/STAR 遗留，
#     二期 MMM 走 OrderManager 内的 DEX 路径，前端不再读这些地址。
#   · VITE_ADMIN_STATS_URL —— 管理页统计改走 Ponder GraphQL
#     （VITE_PONDER_GRAPHQL_URL），不再直连 REST。
#   · VITE_NODE_MINING_ADDRESS / VITE_NODE_VAULT_ADDRESS / VITE_NODE_MINING_START_BLOCK
#     —— 「节点挖矿」一期遗留合约，前端 0 处读取（二期节点走 NodeRegistry）。
# ============================================================
# VITE_FUNDPOOL_ADDRESS=0xCca527AA423AcCC050488180BebD89901E779694
# VITE_STAR_ADDRESS=0x561B1A49870595B3663Ae52D25834bbdF5c27777
# VITE_PANCAKE_ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E
# VITE_WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
# VITE_PRICE_ORACLE_ADDRESS=0xf74d269a9efd023b49C6f64A9582A22d09ea8B63
# VITE_ADMIN_STATS_URL=https://api.anx.autos/api/admin/stats
# VITE_NODE_MINING_ADDRESS=0xF8CA0A788579a9fa234fa08e4E2eB6A715F19f06
# VITE_NODE_VAULT_ADDRESS=0x8863B93f1A1fFd7E3Bf18Ca7805c982cc3DB1DCE
# VITE_NODE_MINING_START_BLOCK=114088822
