# ============================================================
# 一期前端 — BSC 主网（AnxNodeDeploy 部署后填入）
# 用法：部署完成后把地址抄入 solid/.env.production，再 bun run build
# 文档：docs/deploy-phase1.md
#
# 「在用的变量」= solid/src 里 import.meta.env 实际读取的全部键（共 18 个，核对：
# grep -rn "import\.meta\.env" solid/src，含 import.meta.env['KEY'] 动态取键的写法）。
# 本文件是节点站变体，键清单与 .env.example 一致（MMM 保持 0x0 = 不渲染 MMM 页）。
# ============================================================

# 主：BlockPI 付费 BSC RPC；备：公共节点
VITE_RPC_56=https://bsc.blockpi.network/v1/rpc/<BLOCKPI_KEY>
VITE_RPC_56_FALLBACKS=https://bsc-dataseed.binance.org/,https://bsc-dataseed1.binance.org/,https://bsc-rpc.publicnode.com/,https://rpc.ankr.com/bsc

VITE_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# API / GraphQL（生产域名；生产必须写绝对 URL）
VITE_PONDER_GRAPHQL_URL=https://api.anx.autos/graphql
VITE_MMM_API_BASE=https://api.anx.autos

# WalletConnect — https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# MMM 合约 — 节点站保持 0x0（未配置 ⇒ MMM 页只显示提示；MMM 站填六个非零地址）
VITE_MMM_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_ORDER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_MATCHING_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MMM_REWARD_ADDRESS=0x0000000000000000000000000000000000000000

# 平台自营单入口：4 个平台地址，逗号分隔；节点站不配 → 前端不显示平台单入口。
# 必须是同一份名单：链上 OrderManager.isPlatform == keeper 的 PLATFORM_ACCOUNTS == 这里的值。
VITE_PLATFORM_ACCOUNTS=

# ── 部署后从 forge 日志填入 ─────────────────────────────────
VITE_ANX_ADDRESS=0xDEPLOYED_ANX_ADDRESS
VITE_ANX_VESTING_ADDRESS=0xDEPLOYED_VESTING_ADDRESS
VITE_NODE_REGISTRY_ADDRESS=0xDEPLOYED_NODE_REGISTRY_ADDRESS
VITE_ANX_POOL_ADDRESS=0xDEPLOYED_CONTRIBUTION_POOL_ADDRESS

# 系统顶号（无推荐人时默认挂的地址）。留空 = 代码内置
# 0xEC2C15e6382569e9e125f2ED2134e09c71C9F44D，须与链上 rootReferrer 一致
VITE_ROOT_REFERRER=

# 官网外链。留空 = https://anx.autos（routes/m/node.tsx:44）
VITE_ANX_WEBSITE=https://anx.autos

# ============================================================
# ⚠️ 已废弃 / 无代码引用 —— 请勿在新环境里配置
#
# 逐条 grep 核实（grep -rn "import\.meta\.env" solid/src，含 import.meta.env['KEY']
# 动态取键）：下面 2 个键在 solid/src 里 0 处被读取，填了也不会影响任何页面。保留在此
# 仅为对照历史 .env / 一期文档，不代表支持；确认无误后可整块删除。
#   · VITE_PANCAKE_ROUTER_ADDRESS / VITE_WBNB_ADDRESS —— 一期 FundPool/STAR 遗留，
#     前端不再读这两个地址（DEX 路径在合约内，不在前端）。
# ============================================================
# VITE_PANCAKE_ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E
# VITE_WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
