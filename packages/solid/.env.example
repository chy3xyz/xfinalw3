# WalletConnect / Reown (https://cloud.walletconnect.com) — required in production builds
VITE_WALLET_CONNECT_PROJECT_ID=
# VITE_PROJECT_ID=   # alias accepted by scaffold.config.ts

# Networks: comma-separated keys (foundry,sepolia,mainnet). Default foundry.
# VITE_TARGET_CHAINS=foundry
# Per-chain RPC (required when adding sepolia/mainnet):
# VITE_RPC_URL_11155111=
# VITE_RPC_URL_1=

# RPC: unset → same-origin /api/rpc (indexer proxy). Direct Anvil:
# VITE_USE_RPC_PROXY=0
# VITE_RPC_URL=http://127.0.0.1:8545

# Vite proxy target for /api /rpc /ponder → indexer
VITE_PONDER_PROXY=http://127.0.0.1:42069
# Optional GraphQL key when indexer enforces GRAPHQL_API_KEY
# VITE_GRAPHQL_API_KEY=
