# Copy to .env and fill in values. Do not commit real keys.
# Package manager / runtime: Bun (bun install, bun deploy:local, …)

# RPC / explorer (get your own keys for anything beyond local anvil)
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=

# Local anvil keystore account name (default scaffold wallet for localhost only)
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-eth-default

# Optional: override ~/.foundry/keystores
# FOUNDRY_KEYSTORE_DIR=

# Deployer keys live in the Foundry keystore dir — do NOT put private keys here.
# Create: bun account:generate
# Import: bun account:import
# Address: bun account:address
# Reveal (dangerous): bun account:reveal-pk --yes-print
# See docs/DEPLOYER_KEYSTORE.md
