{
  "name": "@w3s/foundry",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "account": "make account",
    "account:generate": "bun scripts-js/generateKeystore.js",
    "account:import": "bun scripts-js/importAccount.js",
    "account:list": "bun scripts-js/listKeystores.js",
    "account:address": "bun scripts-js/showAddress.js",
    "account:reveal-pk": "bun scripts-js/revealPK.js",
    "test:keystore": "bun test scripts-js/keystoreUtils.test.js",
    "chain": "make chain",
    "clean": "forge clean",
    "compile": "make compile",
    "deploy": "bun scripts-js/parseArgs.js",
    "deploy:local": "bun scripts-js/deployLocal.js",
    "flatten": "make flatten",
    "fork": "make fork FORK_URL=${1:-mainnet}",
    "format": "make format",
    "postinstall": "bun -e \"import { copyFileSync, existsSync } from 'fs'; if (!existsSync('.env')) copyFileSync('.env.example', '.env')\"",
    "lint": "make lint",
    "test": "forge test",
    "verify": "make verify RPC_URL=${1:-localhost}"
  },
  "dependencies": {
    "toml": "~3.0.0",
    "viem": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
