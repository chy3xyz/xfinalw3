PUBLIC_APP_URL=http://localhost:5173

# Production server (adapter-bun)
# ORIGIN=https://your.domain
# PORT=3000

# Optional: override Foundry build-info path for blockexplorer server load
# FOUNDRY_BUILD_INFO_DIR=
