# Local-first defaults (Anvil). For a public RPC set PONDER_CHAIN_ID to match.
PONDER_RPC_URL_1=http://127.0.0.1:8545
PONDER_CHAIN_ID=31337
# PONDER_START_BLOCK=0
# Counter from `bun deploy:local` (first CREATE). Empty string disables contract indexing.
# COUNTER_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Required for Bun-native bponder (dev/start/serve)
DATABASE_SCHEMA=xfinalw3
# DATABASE_URL=  # optional; pglite is the local default when unset

# Admin cookie auth (Solid /mng → /api/admin/auth/*)
# echo -n 'changeme' | shasum -a 256
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SHA256=
ADMIN_ROLE=owner
# ADMIN_ACCOUNTS=alice:<sha256hex>:operator,bob:<sha256hex>:viewer
# ADMIN_SESSION_SECRET=
# SESSION_SECRET_FILE=.admin-session-secret
# KEEPER_SECRET=  # machine channel header X-Keeper-Secret
# CORS_ORIGINS=http://localhost:5173

# GraphQL: required in production by default (GRAPHQL_REQUIRE_API_KEY=1|0 overrides)
# GRAPHQL_API_KEY=
# GRAPHQL_REQUIRE_API_KEY=0
# BPONDER_ENV=production

# Public JSON-RPC proxy (POST /rpc) — key stays server-side
RPC_GATEWAY_UPSTREAM=http://127.0.0.1:8545
# Prod default denies unknown methods; set 1 to allow, 0 to deny
# RPC_GATEWAY_ALLOW_UNKNOWN=0
# RPC_GATEWAY_PER_MIN=3000
# RPC_GATEWAY_BURST=600
# RPC_GATEWAY_MAX_BATCH=50
# RPC_GATEWAY_MAX_BODY=262144
# RPC_GATEWAY_TIMEOUT_MS=20000
# RPC_GATEWAY_STATS_SEC=300
