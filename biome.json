{
  "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noDoubleEquals": "off",
        "noGlobalIsNan": "off",
        "noShadowRestrictedNames": "off"
      },
      "correctness": {
        "noUnusedImports": "off",
        "noSelfAssign": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "style": {
        "noUselessElse": "off",
        "useConst": "off",
        "useNodejsImportProtocol": "off",
        "useNumberNamespace": "off",
        "useImportType": "off",
        "useTemplate": "off",
        "noUnusedTemplateLiteral": "off",
        "noInferrableTypes": "off",
        "useExportType": "off",
        "noParameterAssign": "off",
        "noVar": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useArrowFunction": "off",
        "useOptionalChain": "off",
        "noUselessCatch": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "files": {
    "ignore": [
      "contracts",
      "node_modules",
      "dist",
      ".gitignore",
      ".next",
      ".ponder",
      ".svelte-kit",
      "build",
      "cache",
      "out",
      "broadcast",
      "deployments",
      "packages/foundry/lib",
      ".cursor",
      ".superpowers",
      "docs",
      "**/static/app.css",
      "**/deployedContracts.ts"
    ]
  }
}
